# PostgreSQL connection (used ONLY for user accounts, not chat data)
# Using Render's EXTERNAL connection string since the backend runs outside
# Render's private network (e.g. local dev). If you later deploy this
# backend AS a Render service in the same project, switch to the Internal
# Database URL instead — it's faster and doesn't count against external
# connection limits.
DATABASE_URL=postgresql://chatapp_8wkz_user:qrpCXnxOOrfzwoIyZhj8IuWv7XOoMa76@dpg-da19k2gu01pc739pbk9g-a.ohio-postgres.render.com:5432/chatapp_8wkz

# JWT settings
SECRET_KEY=change-this-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Where uploaded files are held TEMPORARILY in-transit (auto-deleted after download / TTL)
FILE_TRANSFER_DIR=./tmp_transfer
FILE_TTL_SECONDS=3600